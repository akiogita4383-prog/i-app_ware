# ── データベース ──────────────────────────────────────────────────
# 本番: RDS PostgreSQL のエンドポイントを指定
DATABASE_URL="postgresql://user:password@your-rds-endpoint.rds.amazonaws.com:5432/ware_db?schema=public"

# ── 認証 ──────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# ── Anthropic Claude API ───────────────────────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ── OpenAI API（コーデ画像生成）────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"

# ── AWS S3 + CloudFront（画像ストレージ）──────────────────────────
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET="ware-images"
CLOUDFRONT_URL="https://your-id.cloudfront.net"

# ── Google OAuth（オプション）─────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── アプリ URL ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
