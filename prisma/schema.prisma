generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items           ClothingItem[]
  outfitHistories OutfitHistory[]
  refreshTokens   RefreshToken[]
  events          Event[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ClothingItem {
  id           String    @id @default(uuid())
  userId       String
  category     String
  name         String
  color        String
  material     String?
  silhouette   String?
  tags         Json      @default("[]")
  imageUrl     String?
  thumbnailUrl String?
  aiConfidence Int?
  wornCount    Int       @default(0)
  lastWornAt   DateTime?
  memo         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("clothing_items")
}

model OutfitHistory {
  id          String    @id @default(uuid())
  userId      String
  date        DateTime  @db.Date
  context     Json
  itemIds     String[]
  itemReasons Json      @default("{}")
  aiTitle     String?
  aiTips      String?
  aiTags      Json      @default("[]")
  status      String    @default("draft")
  rating      Int?
  ratingNote  String?
  isFavorite  Boolean   @default(false)
  wornAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("outfit_histories")
}

model Event {
  id        String   @id @default(uuid())
  userId    String
  title     String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("events")
}
