{
  "expo": {
    "name": "my coordy",
    "slug": "my-coordy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mycoordy",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.akioyamamoto.mycoordy",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "服を撮影してクローゼットに登録するためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "服の写真を選んでクローゼットに登録するために写真ライブラリを使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.akioyamamoto.mycoordy",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "服の写真を選んでクローゼットに登録するために写真ライブラリを使用します。",
          "cameraPermission": "服を撮影してクローゼットに登録するためにカメラを使用します。"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "今日の天気に合わせたコーデを提案するために、現在地のおおよその位置を使用します。"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e6f21d5a-592d-4227-ac58-7b125b48cfc9"
      }
    },
    "owner": "akio-yamamoto"
  }
}
